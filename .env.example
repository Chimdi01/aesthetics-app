DATABASE_URL=postgresql+asyncpg://aesthetics_user:aesthetics_pass@localhost:5433/aesthetics_db
ENVIRONMENT=development
JWT_SECRET_KEY=change-me
# Comma-separated, optional — only set during a key rotation. See
# SECRETS_ROTATION.md.
JWT_PREVIOUS_SECRET_KEYS=
# A real Fernet key — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts TOTP 2FA secrets at rest. See SECRETS_ROTATION.md.
TOTP_ENCRYPTION_KEY=change-me
# DEBUG, INFO, WARNING, ERROR, or CRITICAL — see app/logging_config.py
LOG_LEVEL=INFO
